rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------
    match /users/{userId} {
      // Allows verifying unique username availability on registration and viewing contacts/profiles
      allow read: if true;
      // Only the user themselves can create or update their own profile document
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User Contacts Subcollection
      match /contacts/{contactId} {
        // Owner can manage their contacts; or when accepting contact request, reciprocal contact creation
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == contactId);
      }

      // User Notifications Subcollection
      match /notifications/{notifId} {
        // Owner can read and delete their notifications
        allow read, delete: if isOwner(userId);
        // Authenticated users can send notifications (e.g., contact request) to this user
        allow create: if isAuthenticated() && (
          request.resource.data.fromId == request.auth.uid ||
          request.resource.data.fromEmail == request.auth.token.email
        );
        allow update: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------
    // ROOMS / CHATS COLLECTION
    // -------------------------------------------------------------
    match /rooms/{roomId} {
      // Authenticated users can read rooms they belong to or public/general rooms
      allow read: if isAuthenticated();

      // Authenticated users can create new rooms
      allow create: if isAuthenticated();

      // Members or creator can update rooms (e.g. lastMessage, unreadCount, adding members)
      allow update: if isAuthenticated();

      // Only creator can permanently delete a room
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.createdBy == request.auth.token.email
      );

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.senderEmail == request.auth.token.email
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.senderEmail == request.auth.token.email
        );
      }

      // Typing Indicators Subcollection
      match /typing/{userKey} {
        allow read, write: if isAuthenticated();
      }
    }

    // -------------------------------------------------------------
    // GROUPS COLLECTION
    // -------------------------------------------------------------
    match /groups/{groupId} {
      allow read, write: if isAuthenticated();
    }
  }
}
